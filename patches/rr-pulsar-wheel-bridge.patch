+// ClipInfo's nearest-screen distance feeds DriverController's +0xB4 animation
+// cutoff (0x807CB2D8), including its trick-start callback at 0x807D18EC. The
+// original leaf only reads screens 0-3: a kart on screen 4+ then loses its own
+// stunt animation when far from those four cameras, while physics still tricks.
+// Native fcmpo + ble keeps the previous value on unordered/NaN comparisons.
+static float ClipMinimumDistance(const Clip &clip) {
+    float distance = clip.distance[0];
+    for (u32 s = 1; s < kGameLocal; ++s) {
+        if (distance > clip.distance[s]) distance = clip.distance[s];
+    }
+    for (u32 s = kGameLocal; s < raceScreenCount && s < kMaxLocal; ++s) {
+        const float other = reinterpret_cast<const Clip *>(reinterpret_cast<const u8 *>(&clip) + kClipShadow)->distance[s - kGameLocal];
+        if (distance > other) distance = other;
+    }
+    return distance;
+}
