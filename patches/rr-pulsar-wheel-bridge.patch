diff --git "a/PulsarEngine/SplitScreen8/WheelBridge.cpp" "b/PulsarEngine/SplitScreen8/WheelBridge.cpp"
new file mode 100644
--- /dev/null
+++ "b/PulsarEngine/SplitScreen8/WheelBridge.cpp"
@@ -0,0 +1,309 @@
+#ifdef SS8_WHEEL_BRIDGE
+#include <kamek.hpp>
+#include <core/rvl/OS/OS.hpp>
+#include <core/rvl/WPAD.hpp>
+#include <MarioKartWii/Input/InputManager.hpp>
+#include <SplitScreen8/SplitScreen8.hpp>
+#include <SplitScreen8/WheelBridge.hpp>
+#include <core/egg/mem/Heap.hpp>
+#include <wheel_bridge_mailbox.h>
+#include <wheel_bridge_identity.h>
+#include <wheel_bridge_build.h>
+
+namespace SplitScreen8 {
+namespace {
+using namespace WiiBridgeMailbox;
+static u32 inputStorage[INPUT_SIZE / 4];
+static u32 statusStorage[STATUS_SIZE / 4];
+static u8 descriptor[DESCRIPTOR_SIZE];
+static Receiver receiver;
+static WheelActionState nativeActions[4];
+static bool initialized;
+static u32 lastGeneration, statusGeneration;
+static u32 sBridgeControllersStorage[(sizeof(BridgeWheelController) * 4 + 3) / 4];
+static BridgeWheelController* sBridgeControllers = reinterpret_cast<BridgeWheelController*>(sBridgeControllersStorage);
+
+static void MemoryBarrier() {
+    asm { sync }
+}
+static u32 ReadGeneration(const volatile u8* source) {
+    return (u32(source[0]) << 24) | (u32(source[1]) << 16) | (u32(source[2]) << 8) | source[3];
+}
+static void PublishStatus() {
+    u8 copy[STATUS_SIZE];
+    statusGeneration += 2;
+    receiver.WriteStatus(copy, statusGeneration);
+
+    u32 boundMask = 0;
+    Input::Manager *input = Input::Manager::sInstance;
+    if (input != nullptr) {
+        for (u32 i = 0; i < 4; ++i) {
+            const u32 slot = kGameLocal + i;
+            if (extPads[i].id != 0 && Holder(*input, slot).curController == &sBridgeControllers[i]) {
+                boundMask |= (1 << slot);
+            }
+        }
+    }
+    Write32(copy + 64, boundMask);
+    Write32(copy + 92, Crc32(copy + 4, 88));
+
+    volatile u8* target = reinterpret_cast<volatile u8*>(statusStorage);
+    const u32 odd = statusGeneration - 1;
+    for (u32 i = 0; i < 4; ++i) target[i] = u8(odd >> (24 - 8 * i));
+    MemoryBarrier();
+    for (u32 i = 4; i < STATUS_SIZE; ++i) target[i] = copy[i];
+    MemoryBarrier();
+    for (u32 i = 0; i < 4; ++i) target[i] = copy[i];
+}
+static void Initialize(u32 nowMs) {
+    const u32 session = (OS::GetTick() ^ u32(inputStorage)) | 1;
+    receiver.Reset(session);
+    receiver.SetGameplayMode(true);
+    Clear(descriptor, sizeof(descriptor));
+    const char magic[8] = {'S','S','8','W','B','R','G','1'};
+    for (u32 i = 0; i < 8; ++i) descriptor[i] = magic[i];
+    Write16(descriptor + 8, ABI_VERSION); Write16(descriptor + 10, DESCRIPTOR_SIZE);
+    Write32(descriptor + 12, CAP_DIAGNOSTIC | CAP_WHEEL_INPUT);
+    const u8 buildId[16] = {SS8_WHEEL_BUILD_ID};
+    for (u32 i = 0; i < 16; ++i) descriptor[16 + i] = buildId[i];
+    Write32(descriptor + 32, session); Write32(descriptor + 36, u32(inputStorage));
+    Write32(descriptor + 40, INPUT_SIZE); Write32(descriptor + 44, u32(statusStorage));
+    Write32(descriptor + 48, STATUS_SIZE); Write16(descriptor + 52, 4);
+    Write32(descriptor + 56, 1); Write32(descriptor + 60, Crc32(descriptor, 60));
+
+    for (u32 i = 0; i < 4; ++i) {
+        new (&sBridgeControllers[i]) BridgeWheelController();
+        sBridgeControllers[i].SetSlot(i);
+    }
+
+    MemoryBarrier();
+    initialized = true;
+    OS::Report("ss8 wheel bridge: descriptor=%08x session=%08x abi=1 cap=3\n", descriptor, session);
+    (void)nowMs;
+}
+}
+
+BridgeWheelController::BridgeWheelController() : slotId(0) {
+    this->isDriftAuto = false;
+    this->hasError = false;
+    this->battery = 4;
+    ResetWheelNative(this->wheelState);
+    this->updatedTick = 0xffffffffU;
+    this->lastHostSession = this->lastSourceSession = 0;
+}
+
+BridgeWheelController::~BridgeWheelController() {}
+
+void BridgeWheelController::SetSlot(u32 slot) {
+    this->slotId = slot;
+}
+
+void BridgeWheelController::ResetSelf() {
+    // Native WiiController::ResetSelf only stops rumble. Keep filter lifetime
+    // separate from that virtual call (pause/rumble cleanup is not a new wheel).
+    StopRumble();
+}
+
+void BridgeWheelController::ResetWheelState() {
+    ResetWheelNative(this->wheelState);
+    this->updatedTick = 0xffffffffU;
+}
+
+void BridgeWheelController::SetDriftType(bool autoDrift) {
+    if (this->isDriftAuto != autoDrift) ResetWheelState();
+    this->isDriftAuto = autoDrift;
+}
+
+void BridgeWheelController::Init(bool autoDrift) {
+    ResetWheelState();
+    this->isDriftAuto = autoDrift;
+}
+
+bool BridgeWheelController::IsFresh() const {
+    if (!initialized || !receiver.active || slotId >= 4) return false;
+    const SnapshotSlot &slot = receiver.slots[slotId];
+    const u32 required = FLAG_CONNECTED | FLAG_CALIBRATED | FLAG_SAMPLE_VALID;
+    return receiver.hasSample[slotId] &&
+           ((slot.flags & required) == required) &&
+           !(slot.flags & FLAG_EVENT_OVERFLOW);
+}
+
+bool BridgeWheelController::HasConfirm() const {
+    if (!IsFresh()) return false;
+    return (this->uiinputState.buttonActions & 1) != 0;
+}
+
+void BridgeWheelController::UpdateImpl(Input::State &state, Input::UIState &uiState) {
+    if (this->updatedTick == receiver.guestTick) {
+        state = this->inputState;
+        uiState = this->uiinputState;
+        return;
+    }
+    if (this->lastHostSession != receiver.hostSession || this->lastSourceSession != receiver.sourceSession) {
+        ResetWheelNative(this->wheelState);
+        this->lastHostSession = receiver.hostSession;
+        this->lastSourceSession = receiver.sourceSession;
+    }
+    this->updatedTick = receiver.guestTick;
+    state.buttonActions = 0;
+    state.buttonRaw = 0;
+    state.stick.x = 0.0f;
+    state.stick.z = 0.0f;
+    state.quantisedStickX = 7;
+    state.quantisedStickY = 7;
+    state.motionControlFlick = 0;
+    state.motionControlFlickUnmirrored = 0;
+    state.unknown_0x14[0] &= ~0x80;
+
+    uiState.buttonActions = 0;
+    uiState.rawButtons = 0;
+    uiState.stickX = 0.0f;
+    uiState.stickY = 0.0f;
+    uiState.quantisedStickX = 7;
+    uiState.quantisedStickY = 7;
+    uiState.unknown_0x1A[0x30 - 0x1a] &= ~0x80;
+
+    if (!IsFresh()) {
+        if (this->wheelState.initialized) ResetWheelNative(this->wheelState);
+        return;
+    }
+
+    const SnapshotSlot &slot = receiver.slots[slotId];
+    u16 buttons = 0;
+    u8 trickPulse = 0;
+    if (!receiver.ConsumeActions(slotId, buttons, trickPulse)) {
+        if (this->wheelState.initialized) ResetWheelNative(this->wheelState);
+        return;
+    }
+    StepWheelNative(this->wheelState, slot, buttons, this->isDriftAuto, trickPulse, state);
+
+    // UI Menu inputs (UIState)
+    uiState.rawButtons = buttons;
+
+    if (buttons & (WPAD::WPAD_BUTTON_2 | WPAD::WPAD_BUTTON_A)) {
+        uiState.buttonActions |= 0x1;  // Confirm (2 or A)
+    }
+    if (buttons & (WPAD::WPAD_BUTTON_1 | WPAD::WPAD_BUTTON_B)) {
+        uiState.buttonActions |= 0x2;  // Back (1 or B)
+    }
+    if (buttons & WPAD::WPAD_BUTTON_PLUS) {
+        uiState.buttonActions |= 0x4;  // Start (+)
+    }
+    if (buttons & WPAD::WPAD_BUTTON_RIGHT) {
+        uiState.buttonActions |= 0x8;  // Up
+    }
+    if (buttons & WPAD::WPAD_BUTTON_LEFT) {
+        uiState.buttonActions |= 0x10; // Down
+    }
+    if (buttons & WPAD::WPAD_BUTTON_UP) {
+        uiState.buttonActions |= 0x20; // Left
+    }
+    if (buttons & WPAD::WPAD_BUTTON_DOWN) {
+        uiState.buttonActions |= 0x40; // Right
+    }
+    if (buttons & WPAD::WPAD_BUTTON_MINUS) {
+        uiState.buttonActions |= 0x100; // Minus
+    }
+    // Original WiiController::UpdateImpl publishes UI validity at UIState+0x30.
+    uiState.unknown_0x1A[0x30 - 0x1a] |= 0x80;
+}
+
+void ResetWheelBridgeScene() {
+    for (u32 i = 0; i < 4; ++i) ResetWheelActions(nativeActions[i]);
+    if (initialized) {
+        for (u32 i = 0; i < 4; ++i) sBridgeControllers[i].ResetWheelState();
+    }
+}
+
+extern "C" void ss8WheelNativeUpdateStatesCore(Input::WiiController*, Input::UIState*, Input::State*);
+extern "C" void ss8WheelNativeMotionInit(Input::MotionController*, bool);
+
+// The original WiiController::Init reaches this call on real initialization
+// and extension/reconnection changes. Do not confuse ResetSelf's rumble-stop
+// dispatch with sensor initialization or reset state during ordinary report gaps.
+static void InitializeNativeWheelActions(Input::MotionController* motion, bool autoDrift) {
+    ss8WheelNativeMotionInit(motion, autoDrift);
+    Input::Manager* manager = Input::Manager::sInstance;
+    if (manager != nullptr && motion != nullptr) {
+        for (u32 i = 0; i < kGameLocal; ++i) {
+            if (manager->wiiControllers[i].motionController == motion) ResetWheelActions(nativeActions[i]);
+        }
+    }
+}
+kmCall(0x8051f2e8, InitializeNativeWheelActions);
+
+// Postprocess only the requested action binding for the four native Wheels.
+// The original motion/KPAD update has already run at this verified PAL site.
+// The native core decoder keeps its original UI behavior, steering and flick.
+static void UpdateNativeWheelActions(Input::WiiController* controller, Input::UIState* ui, Input::State* state) {
+    ss8WheelNativeUpdateStatesCore(controller, ui, state);
+    Input::Manager* manager = Input::Manager::sInstance;
+    // This callsite is exclusively the Core/Wheel branch. GetType() still
+    // contains the previous extension type until UpdateImpl's later store.
+    if (manager == nullptr || controller == nullptr || state == nullptr)
+        return;
+    const int channel = controller->GetChannel();
+    if (channel < 0 || channel >= kGameLocal || controller != &manager->wiiControllers[channel])
+        return;
+    ApplyWheelActions(nativeActions[channel], state->buttonRaw, controller->isDriftAuto, *state);
+}
+kmCall(0x8051fe4c, UpdateNativeWheelActions);
+
+BridgeWheelController &GetBridgeController(u32 slot) {
+    if (!initialized) Initialize(OS::TicksToMilliseconds(OS::GetTime()));
+    return sBridgeControllers[slot < 4 ? slot : 0];
+}
+
+static int BridgeControllerIndex(const Input::Controller* controller) {
+    if (initialized && controller != nullptr) {
+        for (u32 i = 0; i < 4; ++i) {
+            if (controller == &sBridgeControllers[i]) return i;
+        }
+    }
+    return -1;
+}
+
+bool IsBridgeController(const Input::Controller* controller) {
+    return BridgeControllerIndex(controller) >= 0;
+}
+
+bool FillBridgeControllerParams(Input::ControllerParams& params, const Input::Controller* controller) {
+    typedef char CheckControllerParamsSize[sizeof(Input::ControllerParams) == 0x10 ? 1 : -1];
+    const int index = BridgeControllerIndex(controller);
+    return index >= 0 && WiiBridgeIdentity::FillProxyParams(reinterpret_cast<u8*>(&params), index);
+}
+
+u32 StableWheelControllerID(const Input::RealControllerHolder* holder) {
+    if (holder == nullptr) return 0;
+    const int index = BridgeControllerIndex(holder->curController);
+    return index >= 0 ? WiiBridgeIdentity::SlotId(index) : calculateID(holder);
+}
+
+u32 DisplayWheelControllerID(u32 id) {
+    return WiiBridgeIdentity::DisplayId(id);
+}
+
+void UpdateWheelBridge() {
+    const u32 nowMs = OS::TicksToMilliseconds(OS::GetTime());
+    if (!initialized) Initialize(nowMs);
+    const volatile u8* source = reinterpret_cast<volatile u8*>(inputStorage);
+    const u32 before = ReadGeneration(source);
+    if (before && !(before & 1) && before != lastGeneration) {
+        u8 copy[INPUT_SIZE];
+        for (u32 i = 0; i < INPUT_SIZE; ++i) copy[i] = source[i];
+        MemoryBarrier();
+        const u32 after = ReadGeneration(source);
+        if (before == after && Read32(copy) == before) {
+            receiver.Accept(copy, nowMs);
+            lastGeneration = before;
+        }
+    }
+    receiver.Tick(nowMs);
+    for (u32 i = 0; i < 4; ++i) {
+        sBridgeControllers[i].UpdateImpl(sBridgeControllers[i].inputState, sBridgeControllers[i].uiinputState);
+    }
+    PublishStatus();
+}
+}
+#endif
+
