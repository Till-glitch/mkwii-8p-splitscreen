diff --git "a/PulsarEngine/SplitScreen8/WheelNative.cpp" "b/PulsarEngine/SplitScreen8/WheelNative.cpp"
new file mode 100644
--- /dev/null
+++ "b/PulsarEngine/SplitScreen8/WheelNative.cpp"
@@ -0,0 +1,169 @@
+#ifdef SS8_WHEEL_BRIDGE
+#include <SplitScreen8/WheelNative.hpp>
+#include <wii_bridge_protocol.h>
+
+namespace SplitScreen8 {
+namespace {
+
+enum {
+    RAW_LEFT = 0x0001,
+    RAW_RIGHT = 0x0002,
+    RAW_DOWN = 0x0004,
+    RAW_UP = 0x0008,
+    RAW_2 = 0x0100,
+    RAW_1 = 0x0200,
+    RAW_B = 0x0400,
+    RAW_A = 0x0800,
+    ACTION_ACCELERATE = 0x0001,
+    ACTION_BRAKE = 0x0002,
+    ACTION_ITEM = 0x0004,
+    ACTION_DRIFT = 0x0008,
+    ACTION_REARVIEW = 0x0020
+};
+
+// KPADStatus's native prefix. Steering takes calibrated accelerometer values
+// and the item decoders use the separate equivalent Wheel hold/trigger/release.
+struct SensorInput {
+    u32 hold, trigger, release;
+    f32 x, y, z;
+};
+struct ItemInput {
+    u32 hold, trigger, release;
+};
+typedef char CheckSensorInputSize[sizeof(SensorInput) == 0x18 ? 1 : -1];
+typedef char CheckItemInputSize[sizeof(ItemInput) == 0x0c ? 1 : -1];
+
+extern "C" {
+void ss8WheelNativeReset(void* owner, void* subState, u32 autoDrift);
+void ss8WheelNativeUpdate(void* owner, void* subState, const SensorInput* input);
+void ss8WheelNativeScalarFilter(void* owner, f32* component, f32 value);
+void ss8WheelNativeItemManual(void* owner, u16* actions, const ItemInput* input, u8* direction);
+void ss8WheelNativeItemAutomatic(void* owner, u16* actions, const ItemInput* input, u8* direction);
+void ss8WheelNativeSetStickXMirrorCheck(Input::State* state, u8 quantised);
+void ss8WheelNativeSetMotionControlFlick(Input::State* state, u8 flick);
+extern f32 ss8WheelNativeKpadThreshold;
+extern f32 ss8WheelNativeKpadGain;
+extern u32 ss8WheelNativeKpadFlags;
+}
+
+// Match the original fctiwz + low-byte sign extension, including NaN/Inf. A C++
+// float-to-int cast would be undefined for those inputs and can use helper code.
+static asm s32 SignedLowByte(f32 value) {
+    nofralloc;
+    stwu r1, -0x10(r1);
+    fctiwz f0, f1;
+    stfd f0, 0x8(r1);
+    lwz r3, 0xc(r1);
+    extsb r3, r3;
+    addi r1, r1, 0x10;
+    blr;
+}
+
+static void FillItems(WheelActionState& state, bool autoDrift, Input::State& output) {
+    u32 hold = output.buttonRaw & 0x000f;
+    if (output.buttonRaw & RAW_B) hold |= RAW_DOWN;
+    // In Wheel orientation native raw LEFT/RIGHT throw backward/forward. They
+    // override B's hold direction, releasing a held item without waiting for B up.
+    if (hold & (RAW_LEFT | RAW_RIGHT)) hold &= ~(RAW_UP | RAW_DOWN);
+    ItemInput input;
+    input.hold = hold;
+    input.trigger = hold & ~state.previousItemHold;
+    input.release = state.previousItemHold & ~hold;
+    state.previousItemHold = hold;
+    u16 actions = output.buttonActions & ~ACTION_ITEM;
+    u8 direction = 7;
+    if (autoDrift)
+        ss8WheelNativeItemAutomatic(state.items, &actions, &input, &direction);
+    else
+        ss8WheelNativeItemManual(state.items, &actions, &input, &direction);
+    output.buttonActions = actions;
+    output.quantisedStickY = direction;
+    output.stick.z = (f32(direction) - 7.0f) / 7.0f;
+}
+
+}  // namespace
+
+void ResetWheelNative(WheelNativeState& state) {
+    u32* words = reinterpret_cast<u32*>(&state);
+    for (u32 i = 0; i < sizeof(state) / sizeof(u32); ++i) words[i] = 0;
+}
+
+void ResetWheelActions(WheelActionState& state) {
+    u32* words = reinterpret_cast<u32*>(&state);
+    for (u32 i = 0; i < sizeof(state) / sizeof(u32); ++i) words[i] = 0;
+}
+
+void ApplyWheelActions(WheelActionState& state, u16 rawButtons, bool autoDrift, Input::State& output) {
+    if (!state.initialized || state.autoDrift != u32(autoDrift)) {
+        ResetWheelActions(state);
+        state.initialized = 1;
+        state.autoDrift = autoDrift;
+    }
+    u16 actions = 0;
+    if (rawButtons & RAW_2) actions |= ACTION_ACCELERATE;
+    if (rawButtons & RAW_1) actions |= ACTION_BRAKE;
+    if (rawButtons & RAW_A) actions |= ACTION_REARVIEW;
+    if ((rawButtons & (RAW_1 | RAW_2)) == (RAW_1 | RAW_2) &&
+        ((state.previousRaceActions & ACTION_DRIFT) || !(state.previousRawButtons & RAW_1)))
+        actions |= ACTION_DRIFT;
+    output.buttonActions = actions;
+    output.buttonRaw = rawButtons;
+    FillItems(state, autoDrift, output);
+    state.previousRawButtons = rawButtons;
+    state.previousRaceActions = output.buttonActions;
+}
+
+u8 QuantiseWheelNativeSteering(f32 steering) {
+    // Separate fmuls in the original order: (1.08 * steering), then * 7.
+    const f32 scaled = 1.0800000429153442f * steering;
+    s32 offset = SignedLowByte(7.0f * scaled);
+    if (offset < -7) offset = -7;
+    if (offset > 7) offset = 7;
+    return u8(offset + 7);
+}
+
+void StepWheelNative(WheelNativeState& state, const WiiBridgeProtocol::SnapshotSlot& sensor,
+                     u16 rawButtons, bool autoDrift, u8 trickPulse, Input::State& output) {
+    if (!state.initialized || state.autoDrift != u32(autoDrift)) {
+        ResetWheelNative(state);
+        u8* bytes = reinterpret_cast<u8*>(state.wheel);
+        ss8WheelNativeReset(bytes, bytes + 0x18, autoDrift);
+        state.autoDrift = autoDrift;
+        state.initialized = 1;
+    }
+
+    SensorInput input;
+    input.hold = rawButtons;
+    input.trigger = rawButtons & ~u32(state.actions.previousRawButtons);
+    input.release = state.actions.previousRawButtons & ~u32(rawButtons);
+    input.x = f32(sensor.accelX) / 128.0f;
+    input.y = f32(sensor.accelY) / 128.0f;
+    input.z = f32(sensor.accelZ) / 128.0f;
+
+    u8* sdk = reinterpret_cast<u8*>(state.sdk);
+    const f32 threshold = ss8WheelNativeKpadThreshold;
+    const f32 gain = ss8WheelNativeKpadGain;
+    if (threshold >= 0.0f && gain > 0.0f && gain <= 1.0f) {
+        *reinterpret_cast<f32*>(sdk + 0x9c) = threshold;
+        *reinterpret_cast<f32*>(sdk + 0xa0) = gain;
+        *reinterpret_cast<u32*>(sdk + 0x534) = ss8WheelNativeKpadFlags;
+        f32* components = &input.x;
+        for (u32 axis = 0; axis < 3; ++axis) {
+            f32* filtered = reinterpret_cast<f32*>(sdk + 0x0c + axis * sizeof(f32));
+            ss8WheelNativeScalarFilter(sdk, filtered, components[axis]);
+            components[axis] = *filtered;
+        }
+    }
+    u8* wheelBytes = reinterpret_cast<u8*>(state.wheel);
+    ss8WheelNativeUpdate(wheelBytes, wheelBytes + 0x18, &input);
+    const f32 steering = *reinterpret_cast<f32*>(wheelBytes + 0x54);
+
+    ss8WheelNativeSetStickXMirrorCheck(&output, QuantiseWheelNativeSteering(steering));
+    ApplyWheelActions(state.actions, rawButtons, autoDrift, output);
+    // The native setter performs any left/right mirror adjustment exactly once.
+    ss8WheelNativeSetMotionControlFlick(&output, trickPulse <= 4 ? trickPulse : 0);
+    output.unknown_0x14[0] |= 0x80;
+}
+
+}  // namespace SplitScreen8
+#endif
diff --git "a/PulsarEngine/SplitScreen8/WheelNative.hpp" "b/PulsarEngine/SplitScreen8/WheelNative.hpp"
new file mode 100644
--- /dev/null
+++ "b/PulsarEngine/SplitScreen8/WheelNative.hpp"
@@ -0,0 +1,50 @@
+#ifndef SS8_WHEEL_NATIVE_HPP
+#define SS8_WHEEL_NATIVE_HPP
+
+#include <MarioKartWii/Input/InputState.hpp>
+
+namespace WiiBridgeProtocol {
+struct SnapshotSlot;
+}
+
+namespace SplitScreen8 {
+
+// Private state for one bridged Wheel. No native Wii/KPAD channel is aliased.
+// Keep this trivially constructible: the game module loads before StaticR.rel.
+struct WheelActionState {
+    u32 items[5];
+    u32 previousItemHold;
+    u16 previousRawButtons;
+    u16 previousRaceActions;
+    u32 initialized;
+    u32 autoDrift;
+};
+struct WheelNativeState {
+    u32 wheel[0x90 / 4];
+    u32 sdk[0x538 / 4];
+    WheelActionState actions;
+    u32 initialized;
+    u32 autoDrift;
+};
+typedef char CheckWheelActionStateSize[sizeof(WheelActionState) == 0x24 ? 1 : -1];
+typedef char CheckWheelNativeStateSize[sizeof(WheelNativeState) == 0x5f4 ? 1 : -1];
+typedef char CheckWheelNativeInputStateSize[sizeof(Input::State) == 0x18 ? 1 : -1];
+
+void ResetWheelNative(WheelNativeState& state);
+void ResetWheelActions(WheelActionState& state);
+
+// Shared desired actions for bridged and native Wheels. Preserve original
+// steering X and original flick; item direction Y belongs to this action map.
+void ApplyWheelActions(WheelActionState& state, u16 rawButtons, bool autoDrift, Input::State& output);
+
+// The caller validates freshness and invokes exactly once per input tick. Raw
+// buttons and trickPulse come from ordered input events, never eventFlags.
+// trickPulse: 0 none, 1 up, 2 down, 3 left, 4 right.
+void StepWheelNative(WheelNativeState& wheel, const WiiBridgeProtocol::SnapshotSlot& sensor,
+                     u16 rawButtons, bool autoDrift, u8 trickPulse, Input::State& output);
+
+// Original signed-low-byte fctiwz path, exposed for independent PPC checks.
+u8 QuantiseWheelNativeSteering(f32 steering);
+
+}  // namespace SplitScreen8
+#endif
