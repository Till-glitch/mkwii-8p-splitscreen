@@ -0,0 +1,44 @@
+#ifndef SS8_WHEEL_BRIDGE_HPP
+#define SS8_WHEEL_BRIDGE_HPP
+
+#include <kamek.hpp>
+#include <MarioKartWii/System/Identifiers.hpp>
+#include <MarioKartWii/Input/Controller.hpp>
+
+namespace SplitScreen8 {
+
+class BridgeWheelController : public Input::Controller {
+public:
+    BridgeWheelController();
+    ~BridgeWheelController() override;
+
+    void SetSlot(u32 slotId);
+
+    void UpdateImpl(Input::State &state, Input::UIState &uiState) override;
+    ControllerType GetType() const override { return WHEEL; }
+    bool HasRumble() const override { return false; }
+    void ActivateRumble() override {}
+    void StopRumble() override {}
+    void ResetSelf() override {}
+    double func_0x24() override { return 0.0; }
+    void TogglePointer(bool enablePointer) override {}
+    bool isPointerEnabled() const override { return false; }
+    void UpdateBatteryField() override {}
+    int GetChannel() const override { return slotId; }
+    void SetDriftType(bool isDriftAuto) override { this->isDriftAuto = isDriftAuto; }
+    const nw4r::ut::detail::RuntimeTypeInfo *GetRuntimeTypeInfo() const override { return nullptr; }
+    u8 GetRemainingBattery() const override { return 4; }
+    void Init(bool isDriftAuto) override { this->isDriftAuto = isDriftAuto; }
+
+    bool IsFresh() const;
+    bool HasConfirm() const;
+
+    u32 slotId;
+};
+
+// Called per frame from UpdateExtHolders.
+void UpdateWheelBridge();
+BridgeWheelController &GetBridgeController(u32 slot);
+
+}  // namespace SplitScreen8
+#endif
